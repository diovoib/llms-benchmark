launcher: ../llama.bat
# launcher: ../ollama.bat
# --api-key and --ctx-size are read from the launchers.

# llama:
base_url: http://127.0.0.1:8080/v1
# ollama:
# base_url: http://127.0.0.1:11434/v1

connect_timeout_s: 2
log_flush_bytes: 256
max_coding_rounds: 7

# Prompts for variants can be found
# - instructed = SYS_INSTRUCTED in src/bench/ . Optional: helpful = SYS_NEUTRAL, harness = harness_system.
prompt_variants: [neutral, helpful, instructed]
harness_system: ""

optional_temp_sweep:
  enabled: false
  suite: tools
  temperatures: [0.0, 0.3, 0.7, 1.0]

models:
  - name: gemma-4-12b-it-Q5_K_M
    recommended_temperature: 0.7

profiles:
  greedy:
    temperature: 0.0
    top_p: 1.0
    top_k: 0
    min_p: 0.0
    repeat_penalty: 1.0
    seed_policy: fixed
    seed: 42
    thinking: false
    chat_template_kwargs:
      enable_thinking: false
  real:
    temperature: null
    top_p: 0.95
    top_k: 40
    min_p: 0.05
    repeat_penalty: 1.1
    seed_policy: unique
    thinking: false
    chat_template_kwargs:
      enable_thinking: false

suites:
  tools:
    request_timeout_s: 60
    max_tokens: 1024
    cases: [T01_pl, T01_en, T02, T03_pl, T03_en, T04_pl, T04_en, T05, T06, T07, T08_pl, T08_en, T09_pl, T09_en, T10, T11_pl, T11_en, T12_pl, T12_en, T13_pl, T13_en, T14_pl, T14_en, T15_pl, T15_en, T16_pl, T16_en, T17_pl, T17_en, T18_pl, T18_en]
    repeats:
      greedy: 2
      real: 5
  agent:
    request_timeout_s: 90
    max_tokens: 1024
    cases: [A01_pl, A01_en, A02_pl, A02_en, A03_pl, A03_en, A04_pl, A04_en, A05, A06_pl, A06_en, A07]
    repeats:
      greedy: 2
      real: 3
  coding:
    request_timeout_s: 2400
    cases: [C01]
    repeats:
      greedy: 1
      real: 1
